{
  "name": "web3-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Application-specific services (wallet linking, payments, subscriptions) for the Web3 layer. Not deployed.",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.ts",
    "dev": "node --watch --env-file-if-exists=.env src/index.ts",
    "migrate": "node --env-file-if-exists=.env src/db/migrate-cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@atproto/crypto": "^0.5.7",
    "@atproto/identity": "^0.5.20",
    "@atproto/xrpc-server": "^0.13.6",
    "@fastify/cors": "^11.3.1",
    "fastify": "^5.12.7",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "viem": "^2.57.12",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
